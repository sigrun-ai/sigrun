# sigrun — example environment for docker/docker-compose.yaml.
# Copy to `.env` next to this file (`cp .env.example .env`) and fill in
# the required keys; compose reads the rest of its config from here.

# Required: provider/model-id against the endpoint below.
SIGRUN_DEFAULT_MODEL=openai/gpt-4o-mini

# The degenerate env-provider credentials (any OpenAI-compatible
# endpoint: OpenAI itself, a local ramalama/ollama, a private gateway).
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# Auth (core hardening W1): compose binds 0.0.0.0 (non-loopback), so the
# token method is the effective default. Leave both unset to drive
# onboarding (the claim flow; the one-time setup code prints to the
# container log), or set exactly one posture:
#   SIGRUN_API_TOKEN=sgr_...   # env service token (admin, outside the
#                              # user directory)
#   SIGRUN_PROXY_SECRET=...    # forward-auth shared secret (proxy method)
#SIGRUN_API_TOKEN=
#SIGRUN_PROXY_SECRET=

# Host-side port mapping (the container always listens on 3000).
SIGRUN_PORT=3000
