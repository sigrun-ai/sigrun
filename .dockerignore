.git
.superpowers
node_modules
webui/node_modules
webui/dist
# The workspace build outputs too — `dist` above is root-anchored and
# does NOT cover these, so stale local builds of shared/tui would ride
# into the image through `COPY . .` (the image builds shared fresh, and
# tui's dist ships only via the explicit --from=build copy, never a
# host tree).
shared/dist
tui/dist
.worktrees
*.log
dist
test-results
.playwright
.env
.env.*
!.env.example

# Never in a build context: prose, tests, spikes and the chart ride
# along into the build stage's `COPY . .` for nothing. docker/ STAYS in
# the context — the container scripts (spec §2) are COPY'd from it, and
# a COPY against an ignored path fails the build.
docs/
test/
spikes/
charts/
