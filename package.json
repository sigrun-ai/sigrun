{
	"name": "sigrun",
	"version": "0.1.0",
	"private": true,
	"description": "Durable personal assistant on pi-durable",
	"type": "module",
	"bin": {
		"sigrun": "src/cli.ts"
	},
	"workspaces": [
		"webui",
		"tui"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build:webui": "npm --workspace @sigrun/webui run build",
		"typecheck:webui": "npm --workspace @sigrun/webui run typecheck",
		"test:e2e": "npm run build:webui && npm --workspace @sigrun/webui run test:e2e"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.0.4",
		"@earendil-works/pi-ai": "^1.0.4",
		"@earendil-works/pi-durable": "1.2.0",
		"@earendil-works/pi-tui": "^1.1.0",
		"@fastify/static": "^9.1.0",
		"fastify": "^5.12.5",
		"tsx": "^4.23.15"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun#readme",
	"files": [
		"src",
		"webui/src",
		"!webui/src/**/*.test.ts",
		"!webui/src/**/*.test.tsx",
		"!webui/src/test-utils.ts",
		"webui/index.html",
		"webui/package.json",
		"webui/tsconfig.json",
		"webui/tsconfig.e2e.json",
		"webui/vite.config.ts",
		"webui/playwright.config.ts",
		"webui/e2e",
		"scripts",
		"docker",
		"charts",
		"Dockerfile",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"CONTEXT.md"
	]
}
