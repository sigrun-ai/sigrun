{
	"name": "@sigrun/sigrun",
	"version": "0.1.5",
	"description": "Durable personal assistant on pi-durable",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./extension": {
			"types": "./dist/extension.d.ts"
		},
		"./blocks": {
			"types": "./dist/blocks/index.d.ts",
			"default": "./dist/blocks/index.js"
		}
	},
	"bin": {
		"sigrun": "dist/cli.js"
	},
	"workspaces": [
		"webui",
		"tui",
		"shared"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"start": "tsx src/index.ts",
		"tui": "tsx src/cli.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build:shared": "npm --workspace @sigrun/shared run build",
		"build": "npm run build:shared && tsc -p tsconfig.build.json && tsc -p tsconfig.extension.json && node -e \"require('node:fs').rmSync('dist/extension.js',{force:true})\"",
		"build:webui": "npm --workspace @sigrun/webui run build",
		"typecheck:webui": "npm --workspace @sigrun/webui run typecheck",
		"test:e2e": "npm run build:webui && npm --workspace @sigrun/webui run test:e2e",
		"prepublishOnly": "node scripts/publish-deps.mjs registry && npm run build && npm run build:webui",
		"postpublish": "node scripts/publish-deps.mjs file"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1154.0",
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@earendil-works/pi-tui": "^1.3.0",
		"@fastify/static": "^9.1.0",
		"@sigrun/ext-codemode": "file:../sigrun-ext-codemode",
		"@sigrun/ext-mcp": "file:../sigrun-ext-mcp",
		"@sigrun/ext-tool-search": "file:../sigrun-ext-tool-search",
		"@sigrun/shared": "0.1.1",
		"croner": "^10.0.1",
		"fastify": "^5.12.5",
		"sharp": "^0.35.5",
		"typebox": "1.3.27"
	},
	"bundleDependencies": [
		"@sigrun/shared"
	],
	"optionalDependencies": {
		"@sigrun/tui": "0.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.4",
		"fast-check": "^4.10.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3",
		"yaml": "^2.9.1"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"dist",
		"webui/dist",
		"THIRD_PARTY_NOTICES.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"CONTEXT.md"
	],
	"allowScripts": {
		"@google/genai@2.21.0": true,
		"esbuild@0.28.2": true,
		"protobufjs@7.6.6": true
	}
}
