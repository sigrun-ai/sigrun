{
	"name": "@sigrun/tui",
	"version": "0.1.0",
	"description": "sigrun terminal client (pi-tui based) over the \u00a75 API \u2014 spawned by the sigrun CLI, or standalone against a server URL",
	"type": "module",
	"bin": {
		"sigrun-tui": "dist/launch.js"
	},
	"exports": {
		".": {
			"types": "./dist/launch.d.ts",
			"default": "./dist/launch.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-tui": "^1.3.0",
		"@sigrun/shared": "0.1.1"
	},
	"devDependencies": {
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun.git",
		"directory": "tui"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun/tree/main/tui#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
